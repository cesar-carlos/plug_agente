{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugagente.dev/schemas/agent.capabilities.v1.json",
  "title": "agent:capabilities payload",
  "type": "object",
  "required": [
    "capabilities"
  ],
  "properties": {
    "capabilities": {
      "type": "object",
      "required": [
        "protocols",
        "encodings",
        "compressions",
        "extensions",
        "limits"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "encodings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "compressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "description": "Negotiated capability extensions. parallelBatchDispatch may be a boolean shorthand (enabled=true with agent defaults) or an object with enabled, maxConcurrency, mixedReadOnlyMethods, and selectOnlySqlExecute to opt into parallel read-only JSON-RPC batch dispatch when both sides support it. sqlOperations is an opt-in versioned journal/transaction capability, not execution authorization or engine certification.",
          "properties": {
            "sqlOperations": {
              "type": "object",
              "required": [
                "enabled",
                "version",
                "durableJournal",
                "singleSourceTransaction",
                "automaticReplay",
                "maxSteps",
                "maxAffectedRows",
                "timeoutMs"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "durableJournal": {
                  "type": "boolean"
                },
                "singleSourceTransaction": {
                  "type": "boolean"
                },
                "automaticReplay": {
                  "type": "boolean"
                },
                "maxSteps": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxAffectedRows": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
