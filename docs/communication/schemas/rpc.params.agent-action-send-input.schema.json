{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugagente.dev/schemas/rpc.params.agent-action-send-input.schema.json",
  "title": "rpc.params.agent-action-send-input.schema.json",
  "description": "I/O v1 contract. Requires explicit negotiation and faithful authorization. Schema presence does not enable runtime support.",
  "type": "object",
  "properties": {
    "client_token": {
      "type": "string",
      "minLength": 1
    },
    "clientToken": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data_base64": {
      "type": "string",
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "execution_id",
    "message_id",
    "sequence",
    "data_base64"
  ],
  "additionalProperties": false
}
