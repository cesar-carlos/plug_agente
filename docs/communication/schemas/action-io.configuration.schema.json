{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugagente.dev/schemas/action-io.configuration.schema.json",
  "title": "action-io.configuration.schema.json",
  "description": "I/O v1 contract. Requires explicit negotiation and faithful authorization. Schema presence does not enable runtime support.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "faithful"
    },
    "close_input": {
      "type": "boolean"
    },
    "initial_input_base64": {
      "type": "string",
      "maxLength": 87384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "version",
    "mode",
    "close_input"
  ],
  "additionalProperties": false
}
