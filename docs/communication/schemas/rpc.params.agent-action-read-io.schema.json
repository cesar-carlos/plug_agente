    "clientToken": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "after_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 262144
    },
    "wait_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
